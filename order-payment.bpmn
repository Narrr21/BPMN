<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:zeebe="http://camunda.org/schema/zeebe/1.0" xmlns:modeler="http://camunda.org/schema/modeler/1.0" id="Definitions_OrderPayment" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Camunda Modeler" exporterVersion="5.0.0" modeler:executionPlatform="Camunda Cloud" modeler:executionPlatformVersion="8.8.0">
  <bpmn:process id="order-payment" name="Order Payment" isExecutable="true">
    <bpmn:startEvent id="StartEvent_OrderReceived" name="Order received">
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:userTask id="Task_ReviewOrder" name="Review Order">
      <bpmn:extensionElements>
        <zeebe:userTask />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:outgoing>Flow_2</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:boundaryEvent id="Boundary_ReviewTimeout" name="Not reviewed in 2 min" attachedToRef="Task_ReviewOrder">
      <bpmn:outgoing>Flow_Timeout</bpmn:outgoing>
      <bpmn:timerEventDefinition id="TimerEventDefinition_1">
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">PT2M</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:boundaryEvent>

    <bpmn:exclusiveGateway id="Gateway_Approved" name="Approved?" default="Flow_Approved">
      <bpmn:incoming>Flow_2</bpmn:incoming>
      <bpmn:outgoing>Flow_Approved</bpmn:outgoing>
      <bpmn:outgoing>Flow_Rejected</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:subProcess id="SubProcess_ProcessPayment" name="Process Payment">
      <bpmn:incoming>Flow_Approved</bpmn:incoming>
      <bpmn:outgoing>Flow_3</bpmn:outgoing>

      <bpmn:startEvent id="StartEvent_Payment" name="Payment started">
        <bpmn:outgoing>Flow_Sub1</bpmn:outgoing>
      </bpmn:startEvent>

      <bpmn:serviceTask id="Task_CheckInventory" name="Check Inventory">
        <bpmn:extensionElements>
          <zeebe:taskDefinition type="io.camunda:http-json:1" />
          <zeebe:ioMapping>
            <zeebe:input source="noAuth" target="authentication.type" />
            <zeebe:input source="POST" target="method" />
            <zeebe:input source="https://httpbin.org/post" target="url" />
            <zeebe:input source="={orderId: orderId, quantity: quantity}" target="body" />
          </zeebe:ioMapping>
          <zeebe:taskHeaders>
            <zeebe:header key="resultVariable" value="inventoryResponse" />
            <zeebe:header key="resultExpression" value="={inStock: not(response.body.json.quantity != null and response.body.json.quantity &gt; 10)}" />
            <zeebe:header key="retryBackoff" value="PT0S" />
          </zeebe:taskHeaders>
        </bpmn:extensionElements>
        <bpmn:incoming>Flow_Sub1</bpmn:incoming>
        <bpmn:outgoing>Flow_Sub2</bpmn:outgoing>
      </bpmn:serviceTask>

      <bpmn:exclusiveGateway id="Gateway_InStock" name="In stock?" default="Flow_NotInStock">
        <bpmn:incoming>Flow_Sub2</bpmn:incoming>
        <bpmn:outgoing>Flow_InStock</bpmn:outgoing>
        <bpmn:outgoing>Flow_NotInStock</bpmn:outgoing>
      </bpmn:exclusiveGateway>

      <bpmn:serviceTask id="Task_ProcessPayment" name="Charge Payment">
        <bpmn:extensionElements>
          <zeebe:taskDefinition type="io.camunda:http-json:1" />
          <zeebe:ioMapping>
            <zeebe:input source="noAuth" target="authentication.type" />
            <zeebe:input source="POST" target="method" />
            <zeebe:input source="https://httpbin.org/post" target="url" />
            <zeebe:input source="={orderId: orderId, amount: amount}" target="body" />
          </zeebe:ioMapping>
          <zeebe:taskHeaders>
            <zeebe:header key="resultVariable" value="paymentResponse" />
            <zeebe:header key="resultExpression" value="={paymentStatus: if response.body.json.amount &gt; 1000000 then &quot;failed&quot; else &quot;success&quot;}" />
            <zeebe:header key="retryBackoff" value="PT0S" />
          </zeebe:taskHeaders>
        </bpmn:extensionElements>
        <bpmn:incoming>Flow_InStock</bpmn:incoming>
        <bpmn:outgoing>Flow_Sub3</bpmn:outgoing>
      </bpmn:serviceTask>

      <bpmn:endEvent id="End_PaymentCharged" name="Payment charged">
        <bpmn:incoming>Flow_Sub3</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:endEvent id="End_OutOfStockError" name="Out of stock">
        <bpmn:incoming>Flow_NotInStock</bpmn:incoming>
        <bpmn:errorEventDefinition id="ErrorEventDefinition_Throw" errorRef="Error_OutOfStock" />
      </bpmn:endEvent>

      <bpmn:sequenceFlow id="Flow_Sub1" sourceRef="StartEvent_Payment" targetRef="Task_CheckInventory" />
      <bpmn:sequenceFlow id="Flow_Sub2" sourceRef="Task_CheckInventory" targetRef="Gateway_InStock" />
      <bpmn:sequenceFlow id="Flow_InStock" name="Yes" sourceRef="Gateway_InStock" targetRef="Task_ProcessPayment">
        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=inStock = true</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="Flow_NotInStock" name="No" sourceRef="Gateway_InStock" targetRef="End_OutOfStockError" />
      <bpmn:sequenceFlow id="Flow_Sub3" sourceRef="Task_ProcessPayment" targetRef="End_PaymentCharged" />
    </bpmn:subProcess>

    <bpmn:boundaryEvent id="Boundary_OutOfStock" name="Out of stock" attachedToRef="SubProcess_ProcessPayment">
      <bpmn:outgoing>Flow_OutOfStock</bpmn:outgoing>
      <bpmn:errorEventDefinition id="ErrorEventDefinition_Catch" errorRef="Error_OutOfStock" />
    </bpmn:boundaryEvent>

    <bpmn:exclusiveGateway id="Gateway_PaymentOk" name="Payment success?" default="Flow_No">
      <bpmn:incoming>Flow_3</bpmn:incoming>
      <bpmn:outgoing>Flow_Yes</bpmn:outgoing>
      <bpmn:outgoing>Flow_No</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:serviceTask id="Task_SendConfirmation" name="Send Confirmation">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="io.camunda:http-json:1" />
        <zeebe:ioMapping>
          <zeebe:input source="noAuth" target="authentication.type" />
          <zeebe:input source="POST" target="method" />
          <zeebe:input source="https://httpbin.org/post" target="url" />
          <zeebe:input source="={orderId: orderId, message: &quot;Your order has been confirmed&quot;}" target="body" />
        </zeebe:ioMapping>
        <zeebe:taskHeaders>
          <zeebe:header key="resultVariable" value="confirmationResponse" />
          <zeebe:header key="retryBackoff" value="PT0S" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Yes</bpmn:incoming>
      <bpmn:outgoing>Flow_4</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:userTask id="Task_HandleFailedPayment" name="Handle Failed Payment">
      <bpmn:extensionElements>
        <zeebe:userTask />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_No</bpmn:incoming>
      <bpmn:outgoing>Flow_5</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:endEvent id="End_Completed" name="Order completed">
      <bpmn:incoming>Flow_4</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="End_PaymentFailed" name="Payment failed">
      <bpmn:incoming>Flow_5</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="End_Expired" name="Order expired">
      <bpmn:incoming>Flow_Timeout</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="End_Rejected" name="Order rejected">
      <bpmn:incoming>Flow_Rejected</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="End_OutOfStock" name="Out of stock">
      <bpmn:incoming>Flow_OutOfStock</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:sequenceFlow id="Flow_1" sourceRef="StartEvent_OrderReceived" targetRef="Task_ReviewOrder" />
    <bpmn:sequenceFlow id="Flow_2" sourceRef="Task_ReviewOrder" targetRef="Gateway_Approved" />
    <bpmn:sequenceFlow id="Flow_Approved" name="Yes" sourceRef="Gateway_Approved" targetRef="SubProcess_ProcessPayment" />
    <bpmn:sequenceFlow id="Flow_Rejected" name="No" sourceRef="Gateway_Approved" targetRef="End_Rejected">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=approved = false</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_3" sourceRef="SubProcess_ProcessPayment" targetRef="Gateway_PaymentOk" />
    <bpmn:sequenceFlow id="Flow_Yes" name="Yes" sourceRef="Gateway_PaymentOk" targetRef="Task_SendConfirmation">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=paymentStatus = "success"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_No" name="No" sourceRef="Gateway_PaymentOk" targetRef="Task_HandleFailedPayment" />
    <bpmn:sequenceFlow id="Flow_4" sourceRef="Task_SendConfirmation" targetRef="End_Completed" />
    <bpmn:sequenceFlow id="Flow_5" sourceRef="Task_HandleFailedPayment" targetRef="End_PaymentFailed" />
    <bpmn:sequenceFlow id="Flow_Timeout" sourceRef="Boundary_ReviewTimeout" targetRef="End_Expired" />
    <bpmn:sequenceFlow id="Flow_OutOfStock" sourceRef="Boundary_OutOfStock" targetRef="End_OutOfStock" />
  </bpmn:process>

  <bpmn:error id="Error_OutOfStock" name="Out of stock" errorCode="OUT_OF_STOCK" />

  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="order-payment">
      <bpmndi:BPMNShape id="StartEvent_OrderReceived_di" bpmnElement="StartEvent_OrderReceived">
        <dc:Bounds x="152" y="102" width="36" height="36" />
        <bpmndi:BPMNLabel><dc:Bounds x="131" y="145" width="78" height="14" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_ReviewOrder_di" bpmnElement="Task_ReviewOrder">
        <dc:Bounds x="240" y="80" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_Approved_di" bpmnElement="Gateway_Approved" isMarkerVisible="true">
        <dc:Bounds x="395" y="95" width="50" height="50" />
        <bpmndi:BPMNLabel><dc:Bounds x="393" y="65" width="54" height="14" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="SubProcess_ProcessPayment_di" bpmnElement="SubProcess_ProcessPayment" isExpanded="false">
        <dc:Bounds x="500" y="80" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_PaymentOk_di" bpmnElement="Gateway_PaymentOk" isMarkerVisible="true">
        <dc:Bounds x="665" y="95" width="50" height="50" />
        <bpmndi:BPMNLabel><dc:Bounds x="648" y="65" width="84" height="14" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_SendConfirmation_di" bpmnElement="Task_SendConfirmation">
        <dc:Bounds x="780" y="80" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_HandleFailedPayment_di" bpmnElement="Task_HandleFailedPayment">
        <dc:Bounds x="780" y="200" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_Completed_di" bpmnElement="End_Completed">
        <dc:Bounds x="952" y="102" width="36" height="36" />
        <bpmndi:BPMNLabel><dc:Bounds x="928" y="145" width="84" height="14" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_PaymentFailed_di" bpmnElement="End_PaymentFailed">
        <dc:Bounds x="952" y="222" width="36" height="36" />
        <bpmndi:BPMNLabel><dc:Bounds x="933" y="265" width="74" height="14" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_Expired_di" bpmnElement="End_Expired">
        <dc:Bounds x="272" y="262" width="36" height="36" />
        <bpmndi:BPMNLabel><dc:Bounds x="255" y="305" width="70" height="14" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_Rejected_di" bpmnElement="End_Rejected">
        <dc:Bounds x="402" y="262" width="36" height="36" />
        <bpmndi:BPMNLabel><dc:Bounds x="384" y="305" width="72" height="14" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_OutOfStock_di" bpmnElement="End_OutOfStock">
        <dc:Bounds x="532" y="262" width="36" height="36" />
        <bpmndi:BPMNLabel><dc:Bounds x="521" y="305" width="58" height="14" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Boundary_ReviewTimeout_di" bpmnElement="Boundary_ReviewTimeout">
        <dc:Bounds x="272" y="142" width="36" height="36" />
        <bpmndi:BPMNLabel><dc:Bounds x="310" y="185" width="60" height="27" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Boundary_OutOfStock_di" bpmnElement="Boundary_OutOfStock">
        <dc:Bounds x="532" y="142" width="36" height="36" />
        <bpmndi:BPMNLabel><dc:Bounds x="570" y="185" width="58" height="14" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNEdge id="Flow_1_di" bpmnElement="Flow_1">
        <di:waypoint x="188" y="120" /><di:waypoint x="240" y="120" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_2_di" bpmnElement="Flow_2">
        <di:waypoint x="340" y="120" /><di:waypoint x="395" y="120" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Approved_di" bpmnElement="Flow_Approved">
        <di:waypoint x="445" y="120" /><di:waypoint x="500" y="120" />
        <bpmndi:BPMNLabel><dc:Bounds x="464" y="102" width="18" height="14" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Rejected_di" bpmnElement="Flow_Rejected">
        <di:waypoint x="420" y="145" /><di:waypoint x="420" y="262" />
        <bpmndi:BPMNLabel><dc:Bounds x="428" y="200" width="15" height="14" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_3_di" bpmnElement="Flow_3">
        <di:waypoint x="600" y="120" /><di:waypoint x="665" y="120" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Yes_di" bpmnElement="Flow_Yes">
        <di:waypoint x="715" y="120" /><di:waypoint x="780" y="120" />
        <bpmndi:BPMNLabel><dc:Bounds x="739" y="102" width="18" height="14" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_No_di" bpmnElement="Flow_No">
        <di:waypoint x="690" y="145" /><di:waypoint x="690" y="240" /><di:waypoint x="780" y="240" />
        <bpmndi:BPMNLabel><dc:Bounds x="698" y="190" width="15" height="14" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_4_di" bpmnElement="Flow_4">
        <di:waypoint x="880" y="120" /><di:waypoint x="952" y="120" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_5_di" bpmnElement="Flow_5">
        <di:waypoint x="880" y="240" /><di:waypoint x="952" y="240" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Timeout_di" bpmnElement="Flow_Timeout">
        <di:waypoint x="290" y="178" /><di:waypoint x="290" y="262" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_OutOfStock_di" bpmnElement="Flow_OutOfStock">
        <di:waypoint x="550" y="178" /><di:waypoint x="550" y="262" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>

  <bpmndi:BPMNDiagram id="BPMNDiagram_ProcessPayment">
    <bpmndi:BPMNPlane id="BPMNPlane_ProcessPayment" bpmnElement="SubProcess_ProcessPayment">
      <bpmndi:BPMNShape id="StartEvent_Payment_di" bpmnElement="StartEvent_Payment">
        <dc:Bounds x="152" y="102" width="36" height="36" />
        <bpmndi:BPMNLabel><dc:Bounds x="129" y="145" width="82" height="14" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_CheckInventory_di" bpmnElement="Task_CheckInventory">
        <dc:Bounds x="240" y="80" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_InStock_di" bpmnElement="Gateway_InStock" isMarkerVisible="true">
        <dc:Bounds x="395" y="95" width="50" height="50" />
        <bpmndi:BPMNLabel><dc:Bounds x="397" y="65" width="46" height="14" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_ProcessPayment_di" bpmnElement="Task_ProcessPayment">
        <dc:Bounds x="500" y="80" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_PaymentCharged_di" bpmnElement="End_PaymentCharged">
        <dc:Bounds x="652" y="102" width="36" height="36" />
        <bpmndi:BPMNLabel><dc:Bounds x="628" y="145" width="84" height="14" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_OutOfStockError_di" bpmnElement="End_OutOfStockError">
        <dc:Bounds x="402" y="222" width="36" height="36" />
        <bpmndi:BPMNLabel><dc:Bounds x="391" y="265" width="58" height="14" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNEdge id="Flow_Sub1_di" bpmnElement="Flow_Sub1">
        <di:waypoint x="188" y="120" /><di:waypoint x="240" y="120" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Sub2_di" bpmnElement="Flow_Sub2">
        <di:waypoint x="340" y="120" /><di:waypoint x="395" y="120" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_InStock_di" bpmnElement="Flow_InStock">
        <di:waypoint x="445" y="120" /><di:waypoint x="500" y="120" />
        <bpmndi:BPMNLabel><dc:Bounds x="464" y="102" width="18" height="14" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_NotInStock_di" bpmnElement="Flow_NotInStock">
        <di:waypoint x="420" y="145" /><di:waypoint x="420" y="222" />
        <bpmndi:BPMNLabel><dc:Bounds x="428" y="176" width="15" height="14" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Sub3_di" bpmnElement="Flow_Sub3">
        <di:waypoint x="600" y="120" /><di:waypoint x="652" y="120" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
